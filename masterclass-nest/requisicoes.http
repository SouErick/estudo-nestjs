POST http://localhost:3000/auth/login
content-type: application/json

{
    "email": "erick@gmail.com",
    "password": "123456"
}

### 
POST http://localhost:3000/auth/login
content-type: application/json

{
    "email": "erick@,dkk",
    "password": "123456"
}

### 
POST http://localhost:3000/auth/login
content-type: application/json

{
    "email": "erick@gmail.com",
    "password": true
}

### 
# campo email inválido — deve retornar 400
curl -X POST http://localhost:3000/auth/login \
  -H "Content-Type: application/json" \
  -d '{"email":"nao-e-um-email","password":"123456"}'

###
# campo extra — deve ser removido (whitelist) ou rejeitado (forbidNonWhitelisted)
curl -X POST http://localhost:3000/auth/login \
  -H "Content-Type: application/json" \
  -d '{"email":"erick@email.com","password":"123456","isAdmin":true}'

###
# tudo certo — deve continuar funcionando
curl -X POST http://localhost:3000/auth/login \
  -H "Content-Type: application/json" \
  -d '{"email":"erick@email.com","password":"123456"}'


###
# faz o login — deve retornar o access_token
curl -X POST http://localhost:3000/auth/login \
  -H "Content-Type: application/json" \
  -d '{"email":"erick@gmail.com","password":"123456"}'